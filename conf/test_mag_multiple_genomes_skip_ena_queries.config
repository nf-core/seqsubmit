/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running minimal tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a fast and simple pipeline test.

    Use as follows:
        nextflow run nf-core/seqsubmit -profile test_mag_multiple_genomes_skip_ena_queries,<docker/singularity> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

process {
    resourceLimits = [
        cpus: 2,
        memory: '12.GB',
        time: '1.h'
    ]

    withName: 'REGISTERSTUDY|SUBMIT|CREATE_MANIFESTS' {
          ext.when = false
    }
}

params {
    config_profile_name        = 'Test --mode mags, test_mag_multiple_genomes_skip_ena_queries profile'
    config_profile_description = 'Multiple-case MAG test with missing rna info, taxonomy, quality and coverage. Test skips all modules using ENA queries.'

    // Input data
    input            = params.pipelines_testdata_base_path + 'seqsubmit/samplesheets/mag_multiple_genomes.csv'
    outdir           = 'test_output'

    mode             = "mags"

    submission_study = "TEST_STUDY"
    center_name      = "TEST_CENTER"

    test_upload      = true

    checkm2_db       = null
    eukcc_db         = 'https://ftp.ebi.ac.uk/pub/databases/metagenomics/eukcc/eukcc2_db_tiny_fungi.tar.gz'
    cat_db           = params.pipelines_testdata_base_path + 'seqsubmit/test_data/small_cat_db/tax-db.tar.gz'
}
