/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running minimal tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a fast and simple pipeline test.

    Use as follows:
        nextflow run nf-core/seqsubmit -profile test_assembly_multiple_cases,<docker/singularity> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

process {
    resourceLimits = [
        cpus: 2,
        memory: '8.GB',
        time: '1.h'
    ]

    // Stop before the upload. For co-assembly - sample is registered and the manifest generated, but nothing is submitted
    withName: 'SUBMIT' {
        ext.when = false
    }
}

params {
    config_profile_name        = 'Test --mode metagenomic_assemblies co-assembly without coverage profile'
    config_profile_description = 'Test for multiple cases of assembly submission. Registers the virtual co-assembly sample on the ENA test server, but skips the upload'

    // Input data
    input = params.pipelines_testdata_base_path + 'seqsubmit/samplesheets/assembly_multiple_cases.csv'
    outdir = 'test_output'

    mode             = "metagenomic_assemblies"
    submission_study = "TEST_STUDY"
    center_name      = "TEST_CENTER"

    test_upload      = true
}
