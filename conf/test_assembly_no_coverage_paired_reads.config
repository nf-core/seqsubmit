/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running minimal tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a fast and simple pipeline test.

    Use as follows:
        nextflow run nf-core/seqsubmit -profile test,<docker/singularity> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

process {
    resourceLimits = [
        cpus: 2,
        memory: '8.GB',
        time: '1.h'
    ]
}

params {
    config_profile_name        = 'Test --mode metagenomic_assemblies no_coverage_paired_reads profile'
    config_profile_description = 'Single-case assembly test with missing coverage and paired-end reads'

    // Input data
    input  = params.pipelines_testdata_base_path + 'seqsubmit/samplesheets/assembly_no_coverage_paired_reads.csv'
    outdir = 'test_output'

    mode             = "metagenomic_assemblies"
    submission_study = "PRJEB98843"
    centre_name      = "TEST_CENTER"

}
