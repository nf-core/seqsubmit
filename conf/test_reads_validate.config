/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running minimal tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a fast and simple pipeline test.

    Use as follows:
        nextflow run nf-core/seqsubmit -profile test_reads_validate,<docker/singularity> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

process {
    resourceLimits = [
        cpus: 2,
        memory: '8.GB',
        time: '1.h'
    ]
}

params {
    config_profile_name        = 'Test --mode reads with raw reads in FASTQ and BAM formats (validate only)'
    config_profile_description = 'Minimal test profile for validation of submission of raw reads in FASTQ and BAM formats'

    // Input data
    input  = params.pipelines_testdata_base_path + 'seqsubmit/samplesheets/samplesheet_reads.csv'
    outdir = 'test_output'

    mode             = "reads"
    webincli_mode    = "validate"
    submission_study = "PRJEB98843"
    center_name      = "TEST_CENTER"

    test_upload      = true
}
