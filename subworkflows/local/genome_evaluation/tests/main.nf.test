nextflow_workflow {

    name "Test Subworkflow GENOME_EVALUATION"
    script "../main.nf"
    workflow "GENOME_EVALUATION"

    tag "subworkflows"
    tag "subworkflows_local"
    tag "subworkflows/genome_evaluation"
    tag "checkm2"
    tag "checkm2/predict"
    tag "checkm2/databasedownload"
    tag "busco"
    tag "busco/busco"
    tag "eukcc"
    tag "untar"
    tag "gunzip"

    test("mixed domains - eukcc - stub") {

        options "-stub"

        when {
            workflow {
                """
                input[0] = channel.of(
                    [
                        [ id:'test_bac', domain:'bac' ],
                        file(params.modules_testdata_base_path + 'genomics/prokaryotes/bacteroides_fragilis/genome/genome.fna.gz', checkIfExists: true)
                    ],
                    [
                        [ id:'test_euk', domain:'euk' ],
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/genome/genome.fasta.gz', checkIfExists: true)
                    ]
                )
                input[1] = null       // checkm2_db - triggers CHECKM2_DATABASEDOWNLOAD
                input[2] = 14897628   // checkm2_db_download_id
                input[3] = 'auto_euk' // busco_db_lineage
                input[4] = null       // busco_db
                input[5] = true       // busco_clean
                input[6] = 'eukcc'    // eukaryotic_completeness_tool
                input[7] = params.modules_testdata_base_path + 'genomics/sarscov2/genome/db/kraken2.tar.gz' // eukcc_db - any archive works in stub mode
                """
            }
        }

        then {
            assert workflow.success
            def stats = workflow.out.stats.collectEntries { meta, completeness, contamination, software -> [ (meta.id): [completeness, contamination, software] ] }
            assertAll(
                { assert snapshot(workflow.out.stats.sort { it[0].id }).match() },
                { assert workflow.out.stats.size() == 2 },
                // CheckM2 stub writes an empty report - no values; EukCC stub writes one row
                { assert stats['test_bac'][0] == null },
                { assert stats['test_bac'][2].startsWith('checkm2_v') },
                { assert stats['test_euk'][0] == '90.0' },  // fake values assigned by eukcc in -stub
                { assert stats['test_euk'][1] == '1.0' },   // fake values assigned by eukcc in -stub
                { assert stats['test_euk'][2].startsWith('eukcc_v') }
            )
        }

    }

    test("prokaryotes only - stub") {

        options "-stub"

        when {
            workflow {
                """
                input[0] = channel.of(
                    [
                        [ id:'test_bac', domain:'bac' ],
                        file(params.modules_testdata_base_path + 'genomics/prokaryotes/bacteroides_fragilis/genome/genome.fna.gz', checkIfExists: true)
                    ],
                    [
                        [ id:'test_arc', domain:'arc' ],
                        file(params.modules_testdata_base_path + 'genomics/prokaryotes/bacteroides_fragilis/genome/genome.fna.gz', checkIfExists: true)
                    ]
                )
                input[1] = null
                input[2] = 14897628
                input[3] = 'auto_euk'
                input[4] = null
                input[5] = true
                input[6] = 'eukcc'
                input[7] = null       // eukcc_db is not required without eukaryotes
                """
            }
        }

        then {
            assert workflow.success
            assertAll(
                { assert snapshot(workflow.out.stats.sort { it[0].id }).match() },
                { assert workflow.out.stats.size() == 2 },
                { assert workflow.out.stats.every { it[3].startsWith('checkm2_v') } },
                // CheckM2 database is downloaded once for all prokaryotes
                { assert workflow.trace.tasks().count { it.name.contains('CHECKM2_DATABASEDOWNLOAD') } == 1 },
                // no eukaryotes - eukaryotic steps must not run
                { assert !workflow.trace.tasks().any { it.name =~ /EUKCC|BUSCO|DB_UNTAR|GUNZIP_FASTA/ } }
            )
        }

    }

    test("eukaryote - busco - stub") {

        options "-stub"

        when {
            workflow {
                """
                input[0] = channel.of([
                    [ id:'test_euk', domain:'euk' ],
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/genome/genome.fasta.gz', checkIfExists: true)
                ])
                input[1] = null
                input[2] = 14897628
                input[3] = 'auto_euk'
                input[4] = null       // busco_db - BUSCO downloads lineages itself
                input[5] = true
                input[6] = 'busco'
                input[7] = params.modules_testdata_base_path + 'genomics/sarscov2/genome/db/kraken2.tar.gz'
                """
            }
        }

        then {
            assert workflow.success
            assertAll(
                { assert snapshot(workflow.out.stats).match() },
                { assert workflow.out.stats.size() == 1 },
                // completeness is taken from BUSCO - stub writes no short summary json, so it is empty
                { assert workflow.out.stats[0][1] == null },
                // contamination is always taken from EukCC
                { assert workflow.out.stats[0][2] == '1.0' },
                { assert workflow.out.stats[0][3] ==~ /busco_v[^;]+;eukcc_v[^;]+/ },
                // no prokaryotes - CheckM2 database must not be downloaded
                { assert !workflow.trace.tasks().any { it.name.contains('CHECKM2') } },
                { assert workflow.trace.tasks().any { it.name.contains('BUSCO_BUSCO') } }
            )
        }

    }

    test("eukaryote with contamination - busco - stub") {

        options "-stub"

        when {
            workflow {
                """
                input[0] = channel.of([
                    [ id:'test_euk', domain:'euk', contamination:2.5, stats_generation_software:'CustomTool_v1.0' ],
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/genome/genome.fasta.gz', checkIfExists: true)
                ])
                input[1] = null
                input[2] = 14897628
                input[3] = 'auto_euk'
                input[4] = null
                input[5] = true
                input[6] = 'busco'
                input[7] = null       // eukcc_db is not required - EukCC is skipped
                """
            }
        }

        then {
            assert workflow.success
            assertAll(
                { assert snapshot(workflow.out.stats).match() },
                { assert workflow.out.stats.size() == 1 },
                // completeness from BUSCO (stub - empty), contamination kept from samplesheet
                { assert workflow.out.stats[0][1] == null },
                { assert workflow.out.stats[0][2] == 2.5 },
                // BUSCO is appended to the software given in samplesheet, EukCC is not listed
                { assert workflow.out.stats[0][3] ==~ /CustomTool_v1\.0;busco_v[^;]+/ },
                { assert !workflow.trace.tasks().any { it.name =~ /EUKCC|GUNZIP_FASTA|DB_UNTAR/ } },
                { assert workflow.trace.tasks().any { it.name.contains('BUSCO_BUSCO') } }
            )
        }

    }

    test("eukaryote with contamination - eukcc - stub") {

        options "-stub"

        when {
            workflow {
                """
                input[0] = channel.of([
                    [ id:'test_euk', domain:'euk', contamination:2.5, stats_generation_software:'CustomTool_v1.0' ],
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/genome/genome.fasta.gz', checkIfExists: true)
                ])
                input[1] = null
                input[2] = 14897628
                input[3] = 'auto_euk'
                input[4] = null
                input[5] = true
                input[6] = 'eukcc'
                input[7] = params.modules_testdata_base_path + 'genomics/sarscov2/genome/db/kraken2.tar.gz'
                """
            }
        }

        then {
            assert workflow.success
            assertAll(
                { assert snapshot(workflow.out.stats).match() },
                { assert workflow.out.stats.size() == 1 },
                // completeness from EukCC, contamination kept from samplesheet
                { assert workflow.out.stats[0][1] == '90.0' },
                { assert workflow.out.stats[0][2] == 2.5 },
                { assert workflow.out.stats[0][3] ==~ /CustomTool_v1\.0;eukcc_v[^;]+/ },
                { assert workflow.trace.tasks().any { it.name.contains('EUKCC_SINGLE') } }
            )
        }

    }

    test("eukaryote - no eukcc_db - stub") {

        options "-stub"

        when {
            workflow {
                """
                input[0] = channel.of([
                    [ id:'test_euk', domain:'euk' ],
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/genome/genome.fasta.gz', checkIfExists: true)
                ])
                input[1] = null
                input[2] = 14897628
                input[3] = 'auto_euk'
                input[4] = null
                input[5] = true
                input[6] = 'eukcc'
                input[7] = null       // eukcc_db missing while eukaryotes are present
                """
            }
        }

        then {
            assert workflow.failed
            assert workflow.stdout.any { it.contains('--eukcc_db is not provided') } ||
                workflow.stderr.any { it.contains('--eukcc_db is not provided') }
        }

    }

}
