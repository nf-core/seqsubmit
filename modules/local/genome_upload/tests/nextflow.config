// Test configuration for GENOME_UPLOAD module.
// Real submission tests register samples on the ENA dev server (discarded daily)
// and require maintainer Webin credentials set as Nextflow secrets.

env {
    ENA_WEBIN          = secrets.ENA_WEBIN
    ENA_WEBIN_PASSWORD = secrets.ENA_WEBIN_PASSWORD
}

process {
    withName: 'GENOME_UPLOAD' {
        ext.args = "--force" // ensures that ENA metadata is re-downloaded even if cache exists
    }
}
